    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "eslint": "^10",
    "eslint-plugin-svelte": "^3.17.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "knip": "^6",
    "lefthook": "^2.1.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.4.8",
    "svelte-eslint-parser": "^1.6.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "idb": "^8.0.3"
  }
