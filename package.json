{
  "name": "better-batch",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build-seed": "bun scripts/build-seed-snapshot.ts",
    "build": "bun run build-seed && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "check": "bun run typecheck && bun run lint && bun run knip && bun test",
    "prepare": "lefthook install",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "android": "bun run build && bun run cap:sync && bun run cap:open"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "^10",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.59.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "eslint": "^10",
    "eslint-plugin-svelte": "^3.17.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "knip": "^6",
    "lefthook": "^2.1.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.4.8",
    "svelte-eslint-parser": "^1.6.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/local-notifications": "^8.2.0",
    "idb": "^8.0.3"
  }
}
