    "check": "bun run typecheck && bun run lint && bun run knip && bun test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-node": "^5.5.4",
